\n<td align=\"left\">分割代码块</td>\n<td align=\"left\"><code>ctrl</code> + <code>shift</code> + <code>-</code></td>\n</tr>\n</tbody></table>\n","feature":true,"text":"编者自用的Python操作技巧...","permalink":"/post/Python","photos":[],"count_time":{"symbolsCount":265,"symbolsTime":"1 mins."},"categories":[{"name":"Python","slug":"Python","count":1,"path":"api/categories/Python.json"}],"tags":[{"name":"Self-use","slug":"Self-use","count":3,"path":"api/tags/Self-use.json"}],"toc":"<ol class=\"toc\"><li class=\"toc-item toc-level-1\"><a class=\"toc-link\" href=\"#%E5%BF%AB%E6%8D%B7%E9%94%AE\"><span class=\"toc-text\">快捷键</span></a></li></ol>","author":{"name":"王观旭","slug":"blog-author","avatar":"/images/avatar.png","link":"https://guanxuwang.github.io","description":"<p>真理所在之处，数学生生不息。</p>The learning materials throughout my life.","socials":{"github":"https://github.com/guanxuwang","twitter":"","stackoverflow":"","wechat":"","qq":"","weibo":"","zhihu":"https://www.zhihu.com/people/wang-guan-xu-96","csdn":"https://blog.csdn.net/GuanxuWANG","juejin":"","customs":{"bilibili":{"icon":"/svg/bilibili.svg","link":"https://space.bilibili.com/23972352"},"mail":{"icon":"/svg/mail.svg","link":"mailto:wanggx11174@163.com"},"wechat-pay":{"icon":"/svg/wechat-pay.svg","link":"/svg/wechat-pay.JPG"}}}},"mapped":true,"hidden":false,"prev_post":{"title":"R语言操作","uid":"105dbb909226a529a9f923ca0d711350","slug":"R","date":"2025-06-07T16:00:00.000Z","updated":"2025-06-30T00:26:34.920Z","comments":true,"path":"api/articles/R.json","keywords":null,"cover":"/images/cover/R.webp","text":"编者自用的R语言操作技巧...","permalink":"/post/R","photos":[],"count_time":{"symbolsCount":316,"symbolsTime":"1 mins."},"categories":[{"name":"R","slug":"R","count":1,"path":"api/categories/R.json"}],"tags":[{"name":"Self-use","slug":"Self-use","count":3,"path":"api/tags/Self-use.json"}],"author":{"name":"王观旭","slug":"blog-author","avatar":"/images/avatar.png","link":"https://guanxuwang.github.io","description":"<p>真理所在之处，数学生生不息。</p>T